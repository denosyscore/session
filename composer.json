{
  "name": "denosyscore/session",
  "description": "Session management and handlers",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "denosyscore/database": "^0.10",
    "denosyscore/encryption": "^0.10",
    "denosyscore/http": "^0.10",
    "psr/log": "^2.0 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Session\\": "src/Session/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.10.x-dev"
    }
  }
}
